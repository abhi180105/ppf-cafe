# ------------------------------
# 🌮 Prime Patties & Foods Config — EXAMPLE
# ------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. It is ignored by .gitignore.

# ✅ Google Apps Script (Phase 1 - keep for backward compatibility)
VITE_SHEET_API_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
VITE_WHATSAPP_NUMBER="917409945954"
VITE_APP_NAME="Prime Patties & Foods"
VITE_DEFAULT_OPEN_TIME="11:00"
VITE_DEFAULT_CLOSE_TIME="23:00"
VITE_THEME="system"
VITE_DEV_NAME="Your Name"
VITE_DEV_EMAIL="your-email@example.com"
VITE_API_SECRET="REPLACE_WITH_YOUR_STRONG_RANDOM_SECRET"

# ✅ Supabase (Phase 2+)
# Public key - safe in frontend bundle
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Server-only - NEVER in frontend (Netlify Functions env vars only)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_DB_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"
