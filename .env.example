# ------------------------------
# 🌮 Prime Patties & Foods Config — EXAMPLE
# ------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git. It is ignored by .gitignore.

# ✅ Google Apps Script backend URL (deploy from SCRIPT.md)
# Get this from: Google Apps Script → Deploy → Manage Deployments → Web App URL
VITE_SHEET_API_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# ✅ WhatsApp number for orders (digits only, no +, include country code)
# Example: 917409945954 for +91 74099 45954
VITE_WHATSAPP_NUMBER=""

# ✅ App name (displayed in UI)
VITE_APP_NAME="Prime Patties & Foods"

# ✅ Fallback cafe hours if Google Sheet Status is unavailable (24-hour format)
VITE_DEFAULT_OPEN_TIME="11:00"
VITE_DEFAULT_CLOSE_TIME="23:00"

# ✅ Default theme (light|dark|system)
VITE_THEME="system"

# ✅ Developer / Owner credit (displayed in footer)
VITE_DEV_NAME="Your Name"

# ✅ Developer email for feedback/messages (used in mailto: links)
VITE_DEV_EMAIL="your-email@example.com"

# ✅ Shared API secret — MUST match API_KEY in deployed Google Apps Script (SCRIPT.md)
# Generate a strong random secret:  openssl rand -hex 32
# This is EXPOSED in the client bundle (Vite inlines VITE_* variables).
# It only raises the bar for automated attacks; it is NOT a strong authorization mechanism.
# True server-side authorization requires Netlify Functions (Phase 2).
# SET A REAL VALUE IN NETLIFY ENV VARS BEFORE PRODUCTION DEPLOY.
VITE_API_SECRET="REPLACE_WITH_YOUR_STRONG_RANDOM_SECRET"